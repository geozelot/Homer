<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebDAV over HTTPS. Cleartext is disabled below (locked decision). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read connectivity so sync can fail fast when offline instead of stalling. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background audio playback + its media notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the CPU and the Wi-Fi radio alive WHILE PLAYING, and only while playing: ExoPlayer
         takes the locks on play and drops them on pause/stop (see setWakeMode in PlaybackService).
         A foreground service keeps the service alive but does NOT keep the device awake — without
         this, playback stalls as soon as the screen goes off or the device starts to doze. Normal
         permission, so it is granted at install with no prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Offline downloads run as a foreground (data-sync) service so they survive the
         app being closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Optional, opt-in only: lets the user store downloads/covers in a folder they pick. NEVER
         requested at install/first run — the app sends the user to the system grant screen ONLY if
         they explicitly choose "Browse device" for a custom folder (needed because SAF's folder
         picker is refused on some ROMs, e.g. certain LineageOS builds). Without it Homer uses its
         own app-private storage. This is why Homer is sideloaded / F-Droid, not on Google Play.
         See README "Permissions". -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- In-app updater: hand a downloaded release APK to the system installer. The user still
         confirms every install in the system dialog, and Android gates this behind a per-app
         "install unknown apps" toggle that only the user can grant — Homer reports whether it has
         it and links to the screen, and can do nothing if it is refused. Nothing installs silently.
         The updater is otherwise inert: the scheduled check is opt-in and off by default. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: resolve a browser / Custom Tabs provider
         for the Login Flow v2 web step. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".HomerApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Homer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Homer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 playback service. Exported so system media controllers and
             Android Auto can bind to it. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <!-- Without this the platform logs "Couldn't find a unique registered media button
                     receiver" on every session, headset and Bluetooth transport buttons are not
                     routed here, and a session resumed from the notification has no button target. -->
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- WorkManager: disable the default initializer so Hilt supplies the
             WorkerFactory via HomerApplication (Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Declare the data-sync FGS type on WorkManager's foreground service so the
             download worker can promote itself with setForeground(). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Media3's own receiver, routing hardware / Bluetooth transport buttons to the session.
             The MEDIA_BUTTON action on the service above is not enough on its own: the platform's
             compat layer resolves media buttons against BROADCAST RECEIVERS, and without one it
             logs "Couldn't find a unique registered media button receiver" on every session and
             headset buttons go nowhere. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Handles Pause / Cancel taps on the download notification. -->
        <receiver
            android:name=".data.download.DownloadActionReceiver"
            android:exported="false" />

        <!-- Outcome of a PackageInstaller session started by the in-app updater. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />

        <!-- Not a service that runs: AppCompat looks for this declaration to decide whether it
             should persist the app's chosen language itself and re-apply it on the next launch.
             Android 13+ stores the choice in the framework; below that this is the only thing that
             makes the setting survive a restart. Disabled and unexported because nothing ever
             binds it — the meta-data IS the whole point. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
