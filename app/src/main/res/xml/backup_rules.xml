<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier; `data_extraction_rules.xml` says the same for 12 and later. Nothing of
     Homer's is backed up — see that file for why. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
