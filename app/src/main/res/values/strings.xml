    <string name="set_full_rescan_confirm_body">Homer will re-read every folder on your server and fetch all cover art again. On a large library this takes a while. Your place, bookmarks and edits are kept.</string>
    <string name="set_full_rescan_confirm_action">Rebuild</string>
