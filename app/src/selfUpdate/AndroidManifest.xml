<?xml version="1.0" encoding="utf-8"?>
<!-- The in-app updater's share of the manifest, merged into every build except F-Droid's, which
     F-Droid itself updates (see `fdroid` in app/build.gradle.kts). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hand a downloaded release APK to the system installer. The user still confirms every install
         in the system dialog, and Android gates this behind a per-app "install unknown apps" toggle
         that only the user can grant — Homer reports whether it has it and links to the screen, and
         can do nothing if it is refused. Nothing installs silently. The updater is otherwise inert:
         the scheduled check is opt-in and off by default. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Outcome of a PackageInstaller session started by the in-app updater. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
